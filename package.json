{
  "name": "unique-av-show-cue",
  "productName": "Unique AV Show Cue",
  "version": "1.1.4",
  "description": "Theatre and live show cue playback: audio, video and image cues with a GO playlist, MIDI and OSC control.",
  "main": "src/main.js",
  "author": "Unique AV",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never",
    "dist:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --arm64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "za.co.uniqueav.showcue",
    "productName": "Unique AV Show Cue",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "fileAssociations": [
      {
        "ext": "showcue",
        "name": "Show Cue File",
        "description": "Unique AV Show Cue show",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Unique AV Show Cue",
      "artifactName": "Unique-AV-Show-Cue-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "artifactName": "Unique-AV-Show-Cue-${version}-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "icon": "build/icon.png",
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Used only to show the names of your audio output devices."
      }
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "dmg": {
      "title": "Unique AV Show Cue ${version}",
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "afterPack": "build/afterPack.js"
  }
}
